<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".SplashScreen">

    <FrameLayout
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:clipChildren="false"
        android:importantForAccessibility="no">

        <!-- Pulse ring (animated from code) -->
        <View
            android:id="@+id/viewPulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pulse_ring"
            android:visibility="invisible"/>

        <!-- Logo badge -->
        <FrameLayout
            android:id="@+id/logoBadge"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_splash_logo"
            android:elevation="@dimen/_6sdp">

            <ImageView
                android:layout_width="66dp"
                android:layout_height="67dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_road_guard" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24sdp"
        android:letterSpacing="-0.02"
        android:text="Road Guard"
        android:textColor="@color/primary_text"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/txtTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="Safer roads. Help is always close."
        android:textColor="@color/secondary_text"
        android:textSize="14sp"/>

    <ProgressBar
        android:id="@+id/progressSplash"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_35sdp"
        android:indeterminateTint="@color/primary_button"/>

</LinearLayout>