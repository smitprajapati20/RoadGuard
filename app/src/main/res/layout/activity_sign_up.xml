<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".SignUp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_21sdp"
        android:paddingVertical="@dimen/_28sdp">

        <FrameLayout
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:background="@drawable/bg_splash_logo"
            android:elevation="@dimen/_5sdp"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_road_guard"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:letterSpacing="-0.02"
            android:text="Create account"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_28sdp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:text="Join Road Guard and travel with help always close."
            android:textColor="@color/secondary_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:autofillHints="name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="Your full name"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:autofillHints="emailAddress"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="you@example.com"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:autofillHints="phoneNational"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLength="10"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="10-digit mobile number"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:autofillHints="newPassword"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="Create a password"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_7sdp"
            android:autofillHints="newPassword"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="Re-enter your password"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:text="Security question (used to reset your password)"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/bg_input">

            <Spinner
                android:id="@+id/spnSecurityQuestion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingEnd="@dimen/_35sdp"
                android:popupBackground="@color/surface"
                android:spinnerMode="dropdown"/>

            <ImageView
                android:layout_width="@dimen/_21sdp"
                android:layout_height="@dimen/_21sdp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/_10sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_down"/>
        </FrameLayout>

        <EditText
            android:id="@+id/edtSecurityAnswer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="@dimen/_10sdp"
            android:hint="Your answer"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account?"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/_43sdp"
                android:paddingStart="@dimen/_5sdp"
                android:text="Log in"
                android:textColor="@color/selected_icon"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
