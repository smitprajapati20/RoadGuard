<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ForgotPassword">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_21sdp"
        android:paddingVertical="@dimen/_28sdp">

        <FrameLayout
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:background="@drawable/bg_splash_logo"
            android:elevation="@dimen/_5sdp"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_road_guard"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_21sdp"
            android:letterSpacing="-0.02"
            android:text="Reset password"
            android:textColor="@color/primary_text"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:text="Enter your email, then verify with your security answer or old password."
            android:textColor="@color/secondary_text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:autofillHints="emailAddress"
            android:imeOptions="actionDone"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="@dimen/_12sdp"
            android:hint="you@example.com"
            android:paddingHorizontal="@dimen/_14sdp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnFindAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/layoutVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_21sdp"
                android:text="Verify it's you"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtSecurityQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_input"
                android:minHeight="@dimen/_47sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:textColor="@color/primary_text"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/edtSecurityAnswer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="@dimen/_10sdp"
                android:hint="Your answer"
                android:paddingHorizontal="@dimen/_14sdp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="OR"
                android:textColor="@color/hint_text"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtOldPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:autofillHints="password"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="@dimen/_10sdp"
                android:hint="Enter your old password"
                android:paddingHorizontal="@dimen/_14sdp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_21sdp"
                android:text="Set a new password"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtNewPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="@dimen/_10sdp"
                android:hint="New password"
                android:paddingHorizontal="@dimen/_14sdp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="@dimen/_10sdp"
                android:hint="Re-enter new password"
                android:paddingHorizontal="@dimen/_14sdp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="Reset password"
                android:textAllCaps="false"
                android:textColor="@color/button_text"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:clickable="true"
            android:gravity="center"
            android:minHeight="@dimen/_43sdp"
            android:text="Back to log in"
            android:textColor="@color/selected_icon"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
